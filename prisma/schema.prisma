generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (e.g. Neon). DATABASE_URL is the pooled connection the app uses;
// DIRECT_URL is the direct connection migrations need. Locally both can be the same.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  passwordHash         String
  // "free" | "pro" (see src/lib/plans.ts)
  plan                 String          @default("free")
  credits              Int
  // When the monthly credit allowance is next refilled.
  creditsResetAt       DateTime
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?
  // When the user asked to upgrade while payments weren't set up yet (the Pro waitlist).
  proWaitlistAt        DateTime?
  createdAt            DateTime        @default(now())
  sessions             Session[]
  decks                Deck[]
  passwordResets       PasswordReset[]
  feedback             Feedback[]
  research             Research[]
  generationJobs       GenerationJob[]
  creditLedger         CreditLedger[]
}

model PasswordReset {
  // sha256 of the token in the emailed link; the raw token is never stored.
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  // sha256 of the session cookie value; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Deck {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  prompt     String
  theme      String    @default("minimal")
  // "quick" | "standard" | "premium" (see src/lib/plans.ts)
  mode       String    @default("standard")
  // Whether anyone with the link can view the deck (the owner can always open it).
  shared     Boolean   @default(true)
  // "Made with Slidezza" badge on the slides (only Pro decks can turn it off).
  badge      Boolean   @default(true)
  // A closing "Made with Slidezza" slide after the last card.
  endSlide   Boolean   @default(false)
  // Where photo credits go: "slide" (on each photo) or "end" (a credits slide at the end).
  credits    String    @default("slide")
  // How much each card says: "low", "medium" or "high" (see src/lib/ai.ts).
  depth      String    @default("medium")
  // The research the deck's facts come from (null for personal or creative decks).
  researchId String?
  research   Research? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cards      Card[]

  @@index([userId, updatedAt])
}

model Card {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  position  Int
  // pending | ready | failed
  status    String   @default("pending")
  // JSON: the outline entry this card was planned from ({ title, points })
  brief     String
  // JSON: CardContent, empty until generated
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@index([deckId, position])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Reply address: the user's email, or one typed in by a visitor (optional).
  email     String?
  // 1 (unhappy) to 4 (love it), or null if not given.
  rating    Int?
  message   String
  // Page the feedback was sent from, e.g. "/d/abc/edit".
  page      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Sources found for a deck's topic: Wikipedia articles plus independent web pages.
// Saved when the outline is made so the deck's cards are written and checked against them.
model Research {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON list of { title, url, kind: "wikipedia" | "web" }.
  sources   String
  // JSON list of { title, text }: the web pages' text (Wikipedia is fetched by title when needed).
  texts     String
  createdAt DateTime @default(now())
  decks     Deck[]

  @@index([userId])
}

// People who asked for Pro or Max before payments opened. They get a confirmation now and
// one email when it opens; the token lets them leave the list from any email.
model ProWaitlist {
  id         String    @id @default(cuid())
  email      String    @unique
  // "pro" | "max"
  plan       String    @default("pro")
  token      String    @unique
  createdAt  DateTime  @default(now())
  // When the "it's open" email was sent.
  notifiedAt DateTime?
}

// One accepted request to write a card. The server owns it: it is charged once when it is
// accepted, runs in the background, and is refunded once if it ends in failure. deckId and
// cardId are plain strings (no foreign keys) so deleting a card or deck never erases what a
// job cost; a job whose card is gone is cancelled and refunded.
//
// Besides the indexes below, the migration adds a partial unique index that allows only one
// queued or running job per card (Prisma can't express it): see
// prisma/migrations/20261008120000_generation_jobs.
model GenerationJob {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId         String
  cardId         String
  // "quick" | "standard" | "premium"
  mode           String
  // Extra instruction from "Rewrite" (empty for the first write).
  instruction    String         @default("")
  // Visitor's country when the job was accepted, so UK/EU routing rules still apply in the background.
  region         String?
  // queued | running | succeeded | failed | cancelled
  status         String         @default("queued")
  // While running: researching | writing | checking | photos.
  stage          String         @default("")
  attempts       Int            @default(0)
  maxAttempts    Int            @default(3)
  // Credits charged when the job was accepted.
  cost           Int
  // Provider and model that wrote the card (set when it succeeds).
  provider       String?
  model          String?
  // Message safe to show to the user, and a short code for the UI.
  error          String?
  errorCode      String?
  // Same key, same job: lets a retried request find the job it already made.
  idempotencyKey String         @unique
  // Not before this time (retries wait here).
  runAfter       DateTime       @default(now())
  // A running job whose lease has passed was abandoned (the worker died) and is recovered.
  lockedUntil    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ledger         CreditLedger[]

  @@index([userId, status, runAfter])
  @@index([deckId, cardId, createdAt])
  @@index([status, runAfter])
}

// Every credit a job takes or gives back. A job has at most one charge and one refund.
model CreditLedger {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Always positive; `type` says which way the credits moved.
  amount    Int
  // "charge" | "refund"
  type      String
  reason    String
  createdAt DateTime       @default(now())

  @@unique([jobId, type])
  @@index([userId, createdAt])
}
