generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (e.g. Neon). DATABASE_URL is the pooled connection the app uses;
// DIRECT_URL is the direct connection migrations need. Locally both can be the same.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  // "free" | "pro" (see src/lib/plans.ts)
  plan                 String    @default("free")
  credits              Int
  // When the monthly credit allowance is next refilled.
  creditsResetAt       DateTime
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  sessions             Session[]
  decks                Deck[]
  passwordResets       PasswordReset[]
}

model PasswordReset {
  // sha256 of the token in the emailed link; the raw token is never stored.
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  // sha256 of the session cookie value; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Deck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  prompt    String
  theme     String   @default("minimal")
  // "quick" | "standard" | "premium" (see src/lib/plans.ts)
  mode      String   @default("standard")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]

  @@index([userId, updatedAt])
}

model Card {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  position  Int
  // pending | ready | failed
  status    String   @default("pending")
  // JSON: the outline entry this card was planned from ({ title, points })
  brief     String
  // JSON: CardContent, empty until generated
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@index([deckId, position])
}
