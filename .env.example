# Copy to .env and fill in. Never commit .env or share these values.

# Database: PostgreSQL connection strings (from Neon: Dashboard → Connect).
# DATABASE_URL = the "pooled" string; DIRECT_URL = the direct (non-pooled) one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# AI. Keep DEMO_AI=1 to try everything with sample content at no cost.
# The "AI team" (src/lib/router.ts) uses every provider that has a key, each for what it does best,
# and falls back to the next when one is busy. Add as many as you like; free ones first:
GEMINI_API_KEY=""          # free: https://aistudio.google.com (not used for UK/EU users unless GEMINI_PAID=1)
GROQ_API_KEY=""            # free: https://console.groq.com (fast; writes and checks cards)
OPENROUTER_API_KEY=""      # free models: https://openrouter.ai (uses "openrouter/free")
ZAI_API_KEY=""             # free GLM Flash: https://z.ai (not used for UK/EU users)
ANTHROPIC_API_KEY=""       # paid: Claude; enables Premium
OPENAI_API_KEY=""          # paid: OpenAI (OPENAI_MODEL, default "gpt-6-astra"); enables Premium
DEMO_AI="1"
# Optional: AI_PROVIDER to put one provider first; GEMINI_PAID="1" once Gemini billing is on;
# GROQ_MODEL / GROQ_CHECK_MODEL / GROQ_VISION_MODEL (reads photos) / OPENROUTER_MODEL / ZAI_MODEL / GEMINI_QUICK_MODEL / GEMINI_STANDARD_MODEL.

# Research for factual decks: Wikipedia (free, no key) plus independent web pages from
# Tavily (free 1,000 searches/month: https://tavily.com). Numbers need two sources that agree.
TAVILY_API_KEY=""

# Photos on slides. On by default with Openverse (free, no key: ~200 searches/day).
# Optional: a Pexels key (https://www.pexels.com/api/) to use Pexels instead. PHOTOS="off" disables photos.
PEXELS_API_KEY=""
PHOTOS=""

# Email for "Forgot password" (any SMTP service). Gmail works with an app password:
# SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER="you@gmail.com", SMTP_PASS="16-letter app password"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""              # optional, e.g. "Slidezza <you@gmail.com>"
APP_URL=""                 # production address, e.g. "https://slidezza.vercel.app": used for canonical links, the sitemap and emails

# Payments (Stripe). Leave empty until you're ready to charge.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""        # recurring price id, e.g. price_123
STRIPE_PRICE_MAX=""        # recurring price id for Max; Max checkout stays hidden until it's set
STRIPE_WEBHOOK_SECRET=""   # from the webhook endpoint pointing at /api/billing/webhook

# Lets you switch Free/Pro without paying, for demos. Ignored when Stripe is set.
# Turn off before real customers use the site.
BILLING_DEMO="1"

# Public contact address shown in the footer and on the Privacy/Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Shown on the "Made with" closing slide (default slidezza.vercel.app).
NEXT_PUBLIC_SITE_DOMAIN=""

# "I'm not a robot" check (ALTCHA, self-hosted, no account or key) on sign-up, forgot password and
# visitor feedback. On by default; CAPTCHA="off" disables it. CAPTCHA_SECRET is optional (a random
# string); without it a secret is derived from DATABASE_URL.
CAPTCHA=""
CAPTCHA_SECRET=""

# Who can open /admin (stats and feedback). Comma-separated emails; NEXT_PUBLIC_CONTACT_EMAIL always can.
ADMIN_EMAILS=""

# Search engines: the "HTML tag" codes from Google Search Console and Bing Webmaster Tools
# (public, not secret). Optional.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Daily summary email to the owner (sign-ups, leads, to-do list). Any long random text; Vercel's
# daily cron (vercel.json) sends it as a password so only Vercel can trigger the email.
CRON_SECRET=""
# Background card generation (see README, "Background generation"). All optional.
JOB_DISPATCHER=""        # "after" (default), "webhook" (external queue) or "none"
JOBS_SECRET=""           # password for /api/jobs/process; falls back to CRON_SECRET
JOB_DISPATCH_URL=""      # queue ingest URL when JOB_DISPATCHER=webhook
JOB_WORKER_SECONDS=""    # how long one worker keeps starting jobs (default 35)
